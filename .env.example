# Ports only. No secrets ever go in .env in this repo.
# scripts/feature.sh / feature.ps1 write a .env like this into each worktree.
WEB_PORT=3000
API_PORT=4000
DB_PORT=5432

# Safe local defaults (no secrets).
DB_HOST=localhost
DB_USER=sensorhub
DB_PASSWORD=sensorhub
DB_NAME=sensorhub
API_BASE_URL=http://localhost:4000
SIMULATOR_INTERVAL_MS=2000
